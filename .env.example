# Local stand secrets. Copy to `.env` (gitignored) and fill in the values:
#   cp .env.example .env
# `bootstrap.sh litellm` writes every key set here into OpenBao on each run
# (rotate = edit .env + re-run); OpenBao then feeds the LiteLLM Secret.
# Set at least one provider key.

# z.ai GLM Coding Plan key (primary provider; https://z.ai/manage-apikey).
# Stored in OpenBao at secret/litellm/zai.
ZAI_API_KEY=

# OpenRouter API key (fallback when the z.ai plan limit is hit;
# https://openrouter.ai/keys). Stored in OpenBao at secret/litellm/openrouter.
OPENROUTER_API_KEY=
