# Local stand secrets. Copy to `.env` (gitignored) and fill in the values:
#   cp .env.example .env
# The bootstrapper moves them into OpenBao on the first run; OpenBao is the
# source of truth afterwards (re-import: `bootstrap.sh llm-key`).

# OpenRouter API key for the LiteLLM gateway (https://openrouter.ai/keys).
# Stored in OpenBao at secret/litellm/openrouter.
OPENROUTER_API_KEY=
